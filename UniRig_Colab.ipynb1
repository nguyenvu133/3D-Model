      "source": [
        "%%bash\n",
        "# 3. Cài thư viện — Colab hiện chạy Python 3.13 nhưng UniRig chỉ chạy được trên Python 3.11,\n",
        "# nên cell này tự tạo môi trường Python 3.11 riêng rồi cài đúng bộ thư viện CUDA cho nó.\n",
        "# Cell này chạy lại được nhiều lần: bước nào xong rồi sẽ bỏ qua, chỉ làm tiếp phần còn thiếu.\n",
        "# Lần đầu mất khoảng 5–10 phút (không còn bước biên dịch).\n",
        "# LƯU Ý: `uv venv` không tự tạo pip trong môi trường, nên mọi lệnh cài đều dùng\n",
        "# `uv pip install --python ...` thay vì gọi pip trong venv.\n",
        "# Cả bộ dùng CUDA 11.8 (không dùng 12.1) vì flash-attn 2.6.3 không có wheel cho torch 2.4 + cu121\n",
        "# (chỉ có cu118/cu123), và spconv-cu121 không có bản 2.3.6 (chỉ có 2.3.7/2.3.8).\n",
        "# Torch dùng 2.3.1. torch-scatter dùng WHEEL LÀM SẴN pt23 (cho torch 2.3.1+cu118):\n",
        "# đã kiểm chứng import OK trong bản Gemini lưu ở 3D-Model (torch-scatter 2.1.2+pt23cu118).\n",
        "# LƯU Ý QUAN TRỌNG: KHÔNG biên dịch torch-scatter từ source trên Colab nữa — nvcc 11.8\n",
        "# không đọc được header glibc 2.39 của Ubuntu 24.04 (lỗi `__builtin_dynamic_object_size`\n",
        "# và `_Float32 is undefined`, 100 errors ở scatter_cuda.cu); NVCC_FLAGS cũng không sửa được.\n",
        "# Vì dùng wheel nên KHÔNG cần cài CUDA Toolkit / nvcc nữa — torch đã có sẵn thư viện CUDA.\n",
        "# Chỉ wheel pt24 (torch 2.4.x) mới lỗi `undefined symbol: parseSchemaOrName` — đừng dùng.\n",
        "set -e\n",
        "export PATH=\"$HOME/.local/bin:$PATH\"\n",
        "if [ ! -x \"$HOME/.local/bin/uv\" ]; then\n",
        "  curl -LsSf https://astral.sh/uv/install.sh | sh\n",
        "  export PATH=\"$HOME/.local/bin:$PATH\"\n",
        "fi\n",
        "uv python install 3.11\n",
        "if [ ! -x /content/venv311/bin/python ]; then\n",
        "  uv venv /content/venv311 --python 3.11\n",
        "fi\n",
        "V=/content/venv311/bin/python\n",
        "uv pip install --python $V \"torch==2.3.1+cu118\" --index-url https://download.pytorch.org/whl/cu118\n",
        "uv pip install --python $V spconv-cu118==2.3.8\n",
        "uv pip install --python $V https://github.com/Dao-AILab/flash-attention/releases/download/v2.6.3/flash_attn-2.6.3+cu118torch2.3cxx11abiFALSE-cp311-cp311-linux_x86_64.whl\n",
        "uv pip install --python $V setuptools wheel ninja\n",
        "if ! $V -c \"import torch_scatter\" 2>/dev/null; then\n",
        "  uv pip uninstall --python $V torch-scatter 2>/dev/null || true\n",
        "  uv pip install --python $V torch-scatter -f https://data.pyg.org/whl/torch-2.3.1+cu118.html\n",
        "fi\n",
        "uv pip install --python $V -r requirements.txt\n",
        "$V -c \"import torch, spconv, torch_scatter, flash_attn, bpy; print('OK - torch', torch.__version__, '| cuda:', torch.cuda.is_available(), '| bpy OK')\"\n"
      ]
    },
