      "source": [
        "# Dùng môi trường Python 3.11 vừa cài ở cell 3 cho mọi lệnh sau này\n",
        "import os\n",
        "os.environ['PATH'] = '/content/venv311/bin:' + os.environ['PATH']\n",
        "# 4. File nhân vật 1 — có sẵn trong repo sau khi clone, không cần up lại\n",
        "INPUT = 'examples/tripo_convert_nhanvat1.glb'\n",
        "NAME = 'nhanvat1'\n",
        "if os.path.exists(INPUT):\n",
        "    print('Dùng file nhân vật 1 có sẵn trong repo:', INPUT)\n",
        "else:\n",
        "    print('Không thấy file trong repo — up file .glb/.fbx/.obj của bạn ở ô hiện ra:')\n",
        "    from google.colab import files\n",
        "    uploaded = files.upload()\n",
        "    INPUT = list(uploaded.keys())[0]\n",
        "    NAME = INPUT.rsplit('.', 1)[0].replace(' ', '_')\n",
        "    print('Input:', INPUT)\n",
        "# Đưa INPUT/NAME sang biến môi trường để các cell bash (5-7) dùng được ($INPUT, $NAME)\n",
        "os.environ['INPUT'] = INPUT\n",
        "os.environ['NAME'] = NAME\n",
        "print('Tên file xuất ra sẽ bắt đầu bằng:', NAME)\n",
        "\n"
      ]
    },
