            "\u001b[0;32m/usr/local/lib/python3.13/dist-packages/IPython/core/magic.py\u001b[0m in \u001b[0;36m<lambda>\u001b[0;34m(f, *a, **k)\u001b[0m\n\u001b[1;32m    185\u001b[0m     \u001b[0;31m# but it's overkill for just that one bit of state.\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    186\u001b[0m     \u001b[0;32mdef\u001b[0m \u001b[0mmagic_deco\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0marg\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m--> 187\u001b[0;31m         \u001b[0mcall\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0;32mlambda\u001b[0m \u001b[0mf\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0;34m*\u001b[0m\u001b[0ma\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0;34m**\u001b[0m\u001b[0mk\u001b[0m\u001b[0;34m:\u001b[0m \u001b[0mf\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m*\u001b[0m\u001b[0ma\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0;34m**\u001b[0m\u001b[0mk\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m    188\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    189\u001b[0m         \u001b[0;32mif\u001b[0m \u001b[0mcallable\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0marg\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n",
            "\u001b[0;32m/usr/local/lib/python3.13/dist-packages/IPython/core/magics/script.py\u001b[0m in \u001b[0;36mshebang\u001b[0;34m(self, line, cell)\u001b[0m\n\u001b[1;32m    243\u001b[0m             \u001b[0msys\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mstderr\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mflush\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    244\u001b[0m         \u001b[0;32mif\u001b[0m \u001b[0margs\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mraise_error\u001b[0m \u001b[0;32mand\u001b[0m \u001b[0mp\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mreturncode\u001b[0m\u001b[0;34m!=\u001b[0m\u001b[0;36m0\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m--> 245\u001b[0;31m             \u001b[0;32mraise\u001b[0m \u001b[0mCalledProcessError\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mp\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mreturncode\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mcell\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0moutput\u001b[0m\u001b[0;34m=\u001b[0m\u001b[0mout\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mstderr\u001b[0m\u001b[0;34m=\u001b[0m\u001b[0merr\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m    246\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    247\u001b[0m     \u001b[0;32mdef\u001b[0m \u001b[0m_run_script\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mself\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mp\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mcell\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mto_close\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n",
            "\u001b[0;31mCalledProcessError\u001b[0m: Command 'b'# 5. B\\xc6\\xb0\\xe1\\xbb\\x9bc 1 \\xe2\\x80\\x94 AI \\xc4\\x91o\\xc3\\xa1n x\\xc6\\xb0\\xc6\\xa1ng cho nh\\xc3\\xa2n v\\xe1\\xba\\xadt 1 (checkpoint t\\xe1\\xbb\\xb1 t\\xe1\\xba\\xa3i t\\xe1\\xbb\\xab Hugging Face l\\xe1\\xba\\xa7n \\xc4\\x91\\xe1\\xba\\xa7u)\\n# D\\xc3\\xb9ng --output_dir thay cho --output: file x\\xc6\\xb0\\xc6\\xa1ng s\\xe1\\xba\\xbd \\xe1\\xbb\\x9f results/$NAME/skeleton.fbx.\\n# (C\\xc3\\xa1ch --output c\\xc5\\xa9 kh\\xc3\\xb4ng sinh ra file m\\xc3\\xa0 c\\xc5\\xa9ng kh\\xc3\\xb4ng b\\xc3\\xa1o l\\xe1\\xbb\\x97i \\xe2\\x80\\x94 \\xc4\\x91\\xc3\\xa3 g\\xe1\\xba\\xb7p \\xe1\\xbb\\x9f b\\xe1\\xba\\xa3n Gemini.)\\nset -e\\nexport PATH=\"/content/venv311/bin:$PATH\"\\ncd /content/UniRig\\nif [ ! -f \"./$NAME.glb\" ]; then cp \"$INPUT\" \"./$NAME.glb\"; fi\\nmkdir -p results\\nSKEL=\"results/$NAME/skeleton.fbx\"\\nif [ ! -f \"$SKEL\" ]; then\\n  echo \"=== B\\xc6\\xb0\\xe1\\xbb\\x9bc 1: \\xc4\\x90o\\xc3\\xa1n x\\xc6\\xb0\\xc6\\xa1ng ===\"\\n  bash launch/inference/generate_skeleton.sh --input \"./$NAME.glb\" --output_dir results\\n  [ -f \"$SKEL\" ] || { echo \"L\\xe1\\xbb\\x96I B\\xc6\\xaf\\xe1\\xbb\\x9aC 1: kh\\xc3\\xb4ng c\\xc3\\xb3 $SKEL. N\\xe1\\xbb\\x99i dung tmp/$NAME:\"; ls -lh \"tmp/$NAME/\"; exit 1; }\\nelse\\n  echo \"B\\xc6\\xb0\\xe1\\xbb\\x9bc 1 \\xc4\\x91\\xc3\\xa3 c\\xc3\\xb3 s\\xe1\\xba\\xb5n: $SKEL\"\\nfi\\nls -lh \"$SKEL\"\\n\\n'' returned non-zero exit status 1."
          ]
        }
      ],
      "source": [
        "%%bash\n",
        "# 5. Bước 1 — AI đoán xương cho nhân vật 1 (checkpoint tự tải từ Hugging Face lần đầu)\n",
        "# Dùng --output_dir thay cho --output: file xương sẽ ở results/$NAME/skeleton.fbx.\n",
        "# (Cách --output cũ không sinh ra file mà cũng không báo lỗi — đã gặp ở bản Gemini.)\n",
        "set -e\n",
        "export PATH=\"/content/venv311/bin:$PATH\"\n",
        "cd /content/UniRig\n",
        "if [ ! -f \"./$NAME.glb\" ]; then cp \"$INPUT\" \"./$NAME.glb\"; fi\n",
        "mkdir -p results\n",
        "SKEL=\"results/$NAME/skeleton.fbx\"\n",
        "if [ ! -f \"$SKEL\" ]; then\n",
        "  echo \"=== Bước 1: Đoán xương ===\"\n",
        "  bash launch/inference/generate_skeleton.sh --input \"./$NAME.glb\" --output_dir results\n",
        "  [ -f \"$SKEL\" ] || { echo \"LỖI BƯỚC 1: không có $SKEL. Nội dung tmp/$NAME:\"; ls -lh \"tmp/$NAME/\"; exit 1; }\n",
        "else\n",
        "  echo \"Bước 1 đã có sẵn: $SKEL\"\n",
        "fi\n",
        "ls -lh \"$SKEL\"\n",
        "\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "ABzaVqVj3jLi"
      },
      "outputs": [],
      "source": [
        "%%bash\n",
        "# 6. Bước 2 — AI tính skinning cho nhân vật 1 (dựa trên xương vừa đoán; nếu xương sai thì sửa xương trước rồi mới chạy bước này)\n",
        "set -e\n",
        "export PATH=\"/content/venv311/bin:$PATH\"\n",
        "cd /content/UniRig\n",
        "SKIN=\"results/${NAME}_skin.fbx\"\n",
        "if [ ! -f \"$SKIN\" ]; then\n",
        "  echo \"=== Bước 2: Tính skinning ===\"\n",
        "  bash launch/inference/generate_skin.sh --input \"results/$NAME/skeleton.fbx\" --output \"$SKIN\"\n",
        "  [ -f \"$SKIN\" ] || { echo \"LỖI BƯỚC 2: không có $SKIN\"; ls -lh results/; exit 1; }\n",
        "else\n",
        "  echo \"Bước 2 đã có sẵn: $SKIN\"\n",
        "fi\n",
        "ls -lh \"$SKIN\"\n",
        "\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "yH5gAAFZ3jLj"
      },
      "outputs": [],
      "source": [
        "%%bash\n",
        "# 7. Bước 3 — Gộp xương + skin vào nhân vật 1 → file đã rig hoàn chỉnh\n",
        "set -e\n",
        "export PATH=\"/content/venv311/bin:$PATH\"\n",
        "cd /content/UniRig\n",
        "RIGGED=\"results/${NAME}_rigged.glb\"\n",
        "if [ ! -f \"$RIGGED\" ]; then\n",
        "  echo \"=== Bước 3: Gộp thành file rig ===\"\n",
        "  bash launch/inference/merge.sh --source \"results/${NAME}_skin.fbx\" --target \"./$NAME.glb\" --output \"$RIGGED\"\n",
        "  [ -f \"$RIGGED\" ] || { echo \"LỖI BƯỚC 3: không có $RIGGED\"; ls -lh results/; exit 1; }\n",
        "else\n",
        "  echo \"Bước 3 đã có sẵn: $RIGGED\"\n",
        "fi\n",
        "echo \"=== XONG ===\"\n",
        "ls -lh results/\n",
        "\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "DXzmIv4f3jLk"
      },
      "outputs": [],
      "source": [
        "# 8. Tải file nhân vật 1 đã rig về máy\n",
        "from google.colab import files\n",
        "files.download(f'results/{NAME}_rigged.glb')\n",
        "files.download(f'results/{NAME}/skeleton.fbx')\n",
        "\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "H13krQNb3jLk"
      },
      "source": [
        "## Nếu gặp lỗi\n",
        "\n",
        "- **Cell 3 báo `bpy==4.2` không có bản phù hợp / `torch_scatter` / `flash_attn` build lỗi** → đó là vì Colab hiện chạy Python 3.13, UniRig chỉ chạy trên Python 3.11. Cell 3 bản mới tự tạo môi trường Python 3.11 riêng (uv) và cài torch 2.3.1+cu118 + wheel torch-scatter pt23 + spconv-cu118 2.3.8 + flash-attn 2.6.3 + bpy 4.2 — chạy lại cell 3 rồi chạy tiếp cell 4–8. Đừng cài thêm gì bằng pip ngoài cell 3. (Không biên dịch torch-scatter từ source: nvcc 11.8 không đọc được header glibc của Ubuntu 24.04.)\n",
        "- **Không thấy GPU / CUDA available: False** → Runtime → Change runtime type → chọn T4 GPU, rồi chạy lại từ cell 1.\n",
        "- **Một bước báo `LỖI BƯỚC 1/2/3: không có file...`** → dừng lại, đừng chạy tiếp: chụp ảnh toàn bộ output của cell đó gửi mình. File xương nằm ở `results/nhanvat1/skeleton.fbx`, file skin ở `results/nhanvat1_skin.fbx`, file rig ở `results/nhanvat1_rigged.glb`.\n",
        "- **Hết VRAM (CUDA out of memory)** → model đầu vào quá nặng: giảm mặt model xuống dưới 50.000 tris trước khi đưa vào (UniRig tự decimate về 50.000 nhưng model gốc quá lớn vẫn có thể tràn).\n",
        "- **Muốn rig model khác** → sửa `INPUT` ở cell 4 thành file bạn upload (hoặc xóa file nhân vật 1 khỏi repo rồi up file mới ở cell 4), rồi chạy lại cell 5–7 — tên file xuất ra đổi theo `NAME` tự động.\n",
        "\n",
        "Repo gốc: https://github.com/VAST-AI-Research/UniRig — Paper SIGGRAPH 2025.\n",
        "\n"
      ]
    }
  ],
